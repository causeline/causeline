{
  "name": "@causeline/react",
  "version": "0.1.0-alpha.0",
  "description": "Causeline React SDK: links React actions and network calls to Spring Boot traces.",
  "license": "Apache-2.0",
  "author": "BGSudharma",
  "homepage": "https://github.com/causeline/causeline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/causeline/causeline.git",
    "directory": "causeline-react"
  },
  "bugs": {
    "url": "https://github.com/causeline/causeline/issues"
  },
  "keywords": [
    "react",
    "spring-boot",
    "tracing",
    "opentelemetry",
    "traceparent",
    "debugging",
    "devtools",
    "observability"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "perf": "vitest run --mode perf fetch.perf",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
